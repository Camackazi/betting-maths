---
interface Props {
  campaign?: "klamic" | "ecosystem";
  variant?: "rail" | "inline";
  placement?: string;
}

const {
  campaign = "klamic",
  variant = "inline",
  placement = "default"
} = Astro.props;

const pathname = Astro.url.pathname;

const ecosystemCampaigns = [
  {
    id: "brazilian-footballer-name-generator",
    brand: "Brazilian Footballer Name Generator",
    headline: "What’s your Brazilian footballer name?",
    href: "https://brazilian-footballer-name-generator.vercel.app/?utm_source=betting_maths&utm_medium=house_ad&utm_campaign=ecosystem_brazilian_name",
    image: "/house-ads/brazilian-footballer-name-generator.svg",
    theme: "brazil"
  },
  {
    id: "pub-quiz-team-name-generator",
    brand: "Pub Quiz Team Name Generator",
    headline: "Need a brilliant pub quiz team name?",
    href: "https://pub-quiz-team-name-generator.vercel.app/?utm_source=betting_maths&utm_medium=house_ad&utm_campaign=ecosystem_quiz_name",
    image: "/house-ads/pub-quiz-team-name-generator.svg",
    theme: "quiz"
  },
  {
    id: "better-darts",
    brand: "Better Darts",
    headline: "Score. Train. Improve.",
    href: "https://better-darts.vercel.app/?utm_source=betting_maths&utm_medium=house_ad&utm_campaign=ecosystem_better_darts",
    image: "/house-ads/better-darts.svg",
    theme: "darts"
  }
];

function hashString(value: string) {
  return Array.from(value).reduce((total, character) => total + character.charCodeAt(0), 0);
}

const selectedEcosystem = ecosystemCampaigns[
  hashString(`${pathname}:${placement}`) % ecosystemCampaigns.length
];

const selected = campaign === "klamic"
  ? {
      id: "klamic-free-invoice",
      brand: "Klamic",
      headline: "Need an invoice?",
      href: "https://klamic.com/?utm_source=betting_maths&utm_medium=house_ad&utm_campaign=free_invoice",
      image: "/house-ads/klamic.svg",
      theme: "klamic"
    }
  : selectedEcosystem;
---

<a
  class:list={["house-ad", `house-ad-${variant}`, `house-ad-${selected.theme}`]}
  href={selected.href}
  target="_blank"
  rel="noopener sponsored"
  aria-label={`${selected.headline} — ${selected.brand}`}
  data-house-ad
  data-house-ad-campaign={selected.id}
  data-house-ad-placement={placement}
>
  <img
    src={selected.image}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
</a>

<style>
  .house-ad {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.72);
    border-radius: 16px;
    background: #071b3d;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.14);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
    isolation: isolate;
  }

  .house-ad::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .house-ad:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.2);
  }

  .house-ad:focus-visible {
    outline: 4px solid #1f8a5b;
    outline-offset: 4px;
  }

  .house-ad img {
    display: block;
    width: 100%;
    height: clamp(110px, 15vw, 150px);
    object-fit: cover;
    object-position: center;
  }

  .house-ad-klamic {
    border-color: rgba(24, 228, 211, 0.72);
    box-shadow: 0 12px 28px rgba(8, 73, 190, 0.22);
  }

  .house-ad-brazil {
    border-color: rgba(255, 209, 24, 0.9);
    box-shadow: 0 12px 28px rgba(11, 112, 49, 0.2);
  }

  .house-ad-quiz {
    border-color: rgba(255, 167, 25, 0.82);
    box-shadow: 0 12px 28px rgba(92, 20, 145, 0.22);
  }

  .house-ad-darts {
    border-color: rgba(178, 242, 0, 0.62);
    box-shadow: 0 12px 28px rgba(0, 70, 58, 0.24);
  }

  .house-ad-rail {
    border-radius: 14px;
  }

  .house-ad-rail img {
    height: 135px;
    object-fit: cover;
    object-position: left center;
  }

  .house-ad-rail.house-ad-klamic img {
    object-position: 3% center;
  }

  .house-ad-rail.house-ad-brazil img,
  .house-ad-rail.house-ad-quiz img,
  .house-ad-rail.house-ad-darts img {
    object-position: 2% center;
  }

  @media (max-width: 700px) {
    .house-ad {
      border-radius: 14px;
    }

    .house-ad img {
      height: 110px;
      object-fit: cover;
      object-position: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .house-ad {
      transition: none;
    }

    .house-ad:hover {
      transform: none;
    }
  }
</style>
