---
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const isCalculatorHub = pathname === "/calculators/";
const isSitemap = pathname === "/sitemap/";

const calculators = [
  {
    title: "No-Vig Fair Odds Calculator",
    href: "/calculators/no-vig-fair-odds-calculator/",
    topic: "Odds and market margin",
    description: "Remove bookmaker margin from a simple two-outcome market and estimate fair probabilities and fair decimal odds."
  },
  {
    title: "Expected Value Calculator",
    href: "/calculators/expected-value-calculator/",
    topic: "Value and probability",
    description: "Estimate expected value and expected ROI from stake, decimal odds and your own win probability estimate."
  },
  {
    title: "Dead Heat Calculator",
    href: "/calculators/dead-heat-calculator/",
    topic: "Racing and each-way",
    description: "Estimate adjusted return, profit or loss and equivalent odds when a selection is affected by a dead heat."
  }
];
---

{(isCalculatorHub || isSitemap) && (
  <section class="content-card new-calculator-integration" aria-labelledby="new-calculators-heading">
    <p class="eyebrow">Betting calculators</p>
    <h2 id="new-calculators-heading">Additional betting calculators</h2>
    <p>
      These calculators extend the Betting Maths tools for market margin, expected value and racing settlement examples. They are for educational calculations only and do not provide betting tips or guaranteed profit strategies.
    </p>

    <div class="new-calculator-grid">
      {calculators.map((calculator) => (
        <a class="new-calculator-card" href={calculator.href}>
          <span>{calculator.topic}</span>
          <h3>{calculator.title}</h3>
          <p>{calculator.description}</p>
        </a>
      ))}
    </div>

    {isCalculatorHub && (
      <div class="new-calculator-table-wrap">
        <h2>Which new calculator do I need?</h2>
        <table class="new-calculator-table">
          <thead>
            <tr>
              <th>What you want to calculate</th>
              <th>Best calculator</th>
              <th>What it shows</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Remove bookmaker margin from a two-outcome market</td>
              <td><a href="/calculators/no-vig-fair-odds-calculator/">No-Vig Fair Odds Calculator</a></td>
              <td>Implied probabilities, book percentage, overround, no-vig probabilities and fair odds.</td>
            </tr>
            <tr>
              <td>Estimate expected value from stake, odds and probability</td>
              <td><a href="/calculators/expected-value-calculator/">Expected Value Calculator</a></td>
              <td>Profit if the bet wins, expected value, expected ROI and a plain-English EV message.</td>
            </tr>
            <tr>
              <td>Calculate adjusted returns after a dead heat</td>
              <td><a href="/calculators/dead-heat-calculator/">Dead Heat Calculator</a></td>
              <td>Winning stake portion, losing stake portion, adjusted return, profit or loss and equivalent odds.</td>
            </tr>
          </tbody>
        </table>
      </div>
    )}
  </section>
)}

<style>
  .new-calculator-integration {
    margin-top: 1.25rem;
  }

  .new-calculator-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .new-calculator-card {
    display: block;
    padding: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg);
  }

  .new-calculator-card:hover {
    border-color: rgba(31, 138, 91, 0.45);
    transform: translateY(-2px);
  }

  .new-calculator-card span {
    display: inline-flex;
    margin-bottom: 0.5rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #eef8f3;
    color: var(--color-green-dark);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .new-calculator-card h3 {
    margin-bottom: 0.35rem;
  }

  .new-calculator-card p {
    margin: 0;
    color: var(--color-muted);
  }

  .new-calculator-table-wrap {
    margin-top: 1.25rem;
  }

  .new-calculator-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
  }

  .new-calculator-table th,
  .new-calculator-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: middle;
  }

  .new-calculator-table th {
    color: var(--color-navy);
    background: #f4f7fa;
    font-size: 0.9rem;
  }

  .new-calculator-table tr:last-child td {
    border-bottom: 0;
  }

  .new-calculator-table a {
    color: var(--color-green-dark);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 980px) {
    .new-calculator-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .new-calculator-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
