---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import AdSlot from "../components/AdSlot.astro";
import HouseAd from "../components/HouseAd.astro";
import SeoHead from "../components/SeoHead.astro";
import RelatedContent from "../components/RelatedContent.astro";
import NewCalculatorIntegration from "../components/NewCalculatorIntegration.astro";
import ContentStandards from "../components/ContentStandards.astro";
import CookieConsent from "../components/CookieConsent.astro";
import "../styles/global.css";

const {
  title = "Betting Maths",
  description = "Free betting calculators and plain-English guides to help you understand odds, stakes and bookmaker margins.",
  datePublished,
  dateModified
} = Astro.props;

const rawPathname = Astro.url.pathname;
const pathname = rawPathname === "/" || rawPathname.endsWith("/")
  ? rawPathname
  : `${rawPathname}/`;

const isHomePage = pathname === "/";
const isCalculatorHub = pathname === "/calculators/";
const isGuideHub = pathname === "/guides/";
const isAnalysisHub = pathname === "/analysis/";
const isCalculatorPage = pathname.startsWith("/calculators/") && !isCalculatorHub;
const isGuidePage = pathname.startsWith("/guides/") && !isGuideHub;
const isAnalysisPage = pathname.startsWith("/analysis/") && !isAnalysisHub;
const isGlossaryPage = pathname.startsWith("/glossary/");
const isResearchDataPage = pathname === "/research-data/";

const showHouseAds =
  isHomePage ||
  isCalculatorHub ||
  isGuideHub ||
  isAnalysisHub ||
  isCalculatorPage ||
  isGuidePage ||
  isAnalysisPage ||
  isGlossaryPage ||
  isResearchDataPage;

const showAutoToc = isGuidePage || isAnalysisPage;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SeoHead title={title} description={description} datePublished={datePublished} dateModified={dateModified} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />

    <div class:list={["site-shell", showHouseAds && "site-shell-house-ads"]}>
      <Sidebar />

      <main class="main-content">
        {showAutoToc && (
          <nav class="auto-toc" data-auto-toc hidden aria-label="On this page">
            <p class="auto-toc-title">On this page</p>
            <ol data-auto-toc-list></ol>
          </nav>
        )}

        <slot />

        {showHouseAds && (
          <div class="house-ad-inline-slot house-ad-inline-primary" data-house-primary-inline>
            <HouseAd campaign="klamic" variant="inline" placement="primary-inline" />
          </div>
        )}

        {showHouseAds && (
          <div class="house-ad-inline-slot house-ad-inline-secondary" data-house-secondary-inline>
            <HouseAd campaign="ecosystem" variant="inline" placement="secondary-inline" />
          </div>
        )}

        <ContentStandards />

        <NewCalculatorIntegration />

        <RelatedContent />

        <AdSlot position="page-end" />
      </main>

      {showHouseAds && (
        <aside class="house-ad-rail" aria-label="Promotions">
          <div class="house-ad-rail-sticky">
            <HouseAd campaign="klamic" variant="rail" placement="primary-rail" />
            <div class="house-ad-rail-secondary">
              <HouseAd campaign="ecosystem" variant="rail" placement="secondary-rail" />
            </div>
          </div>
        </aside>
      )}
    </div>

    <Footer />

    <CookieConsent />

    <script>
      const toggle = document.querySelector("[data-menu-toggle]");
      const sidebar = document.querySelector("[data-sidebar]");
      toggle?.addEventListener("click", () => {
        sidebar?.classList.toggle("open");
      });
    </script>

    <script is:inline>
      const toc = document.querySelector("[data-auto-toc]");
      const tocList = document.querySelector("[data-auto-toc-list]");
      const main = document.querySelector(".main-content");

      function createSlug(text) {
        return text
          .toLowerCase()
          .trim()
          .replace(/&/g, "and")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      if (toc && tocList && main) {
        const headings = Array.from(main.querySelectorAll("h2"))
          .filter((heading) => !heading.closest("[data-auto-toc]"))
          .filter((heading) => !heading.closest(".related-content-section"))
          .filter((heading) => !heading.closest(".standards-panel"))
          .filter((heading) => !heading.closest(".calculator-methodology-panel"))
          .filter((heading) => heading.textContent && heading.textContent.trim().length > 0);

        if (headings.length >= 3) {
          const usedIds = new Set();

          headings.forEach((heading) => {
            const headingText = heading.textContent.trim();
            let baseId = heading.id || createSlug(headingText) || "section";
            let finalId = baseId;
            let counter = 2;

            while (usedIds.has(finalId) || document.getElementById(finalId)) {
              finalId = `${baseId}-${counter}`;
              counter += 1;
            }

            usedIds.add(finalId);
            heading.id = finalId;

            const item = document.createElement("li");
            const link = document.createElement("a");

            link.href = `#${finalId}`;
            link.textContent = headingText;

            item.appendChild(link);
            tocList.appendChild(item);
          });

          const firstContentCard = main.querySelector(".content-card");

          if (firstContentCard) {
            firstContentCard.insertAdjacentElement("afterend", toc);
          }

          toc.hidden = false;
        }
      }
    </script>

    <script is:inline>
      const houseAdMain = document.querySelector(".main-content");
      const primaryInline = document.querySelector("[data-house-primary-inline]");
      const secondaryInline = document.querySelector("[data-house-secondary-inline]");
      const currentPath = window.location.pathname.endsWith("/") || window.location.pathname === "/"
        ? window.location.pathname
        : `${window.location.pathname}/`;

      function directContentCards() {
        if (!houseAdMain) return [];
        return Array.from(houseAdMain.children).filter((element) =>
          element.classList?.contains("content-card") &&
          !element.classList.contains("related-content-section")
        );
      }

      if (houseAdMain && primaryInline) {
        const cards = directContentCards();
        let primaryTarget = null;

        if (currentPath.startsWith("/calculators/") && currentPath !== "/calculators/") {
          primaryTarget = houseAdMain.querySelector(".calculator-panel")?.closest(".content-card") || cards[0];
        } else if (
          (currentPath.startsWith("/guides/") && currentPath !== "/guides/") ||
          (currentPath.startsWith("/analysis/") && currentPath !== "/analysis/")
        ) {
          primaryTarget = cards[1] || cards[0];
        } else if (currentPath === "/") {
          primaryTarget = houseAdMain.querySelector(".research-feature") || cards[0];
        } else {
          primaryTarget = cards[0];
        }

        primaryTarget?.insertAdjacentElement("afterend", primaryInline);
      }

      if (houseAdMain && secondaryInline) {
        const cards = directContentCards();
        if (cards.length > 0) {
          const targetIndex = Math.min(
            cards.length - 1,
            Math.max(1, Math.floor(cards.length * 0.6))
          );
          cards[targetIndex]?.insertAdjacentElement("afterend", secondaryInline);
        }
      }

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const ad = target.closest("[data-house-ad]");
        if (!ad) return;

        if (typeof window.gtag === "function") {
          window.gtag("event", "house_ad_click", {
            campaign: ad.getAttribute("data-house-ad-campaign") || "unknown",
            placement: ad.getAttribute("data-house-ad-placement") || "unknown",
            destination: ad.getAttribute("href") || ""
          });
        }
      });
    </script>

    <style>
      .auto-toc {
        margin: 1.25rem 0;
        padding: 1rem 1.15rem;
        border: 1px solid var(--color-border);
        border-left: 5px solid var(--color-green);
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
      }

      .auto-toc-title {
        margin: 0 0 0.65rem;
        color: var(--color-navy);
        font-weight: 900;
      }

      .auto-toc ol {
        display: grid;
        gap: 0.35rem;
        margin: 0;
        padding-left: 1.25rem;
      }

      .auto-toc li {
        color: var(--color-muted);
      }

      .auto-toc a {
        color: var(--color-green-dark);
        font-weight: 800;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .auto-toc a:hover {
        color: var(--color-green);
      }

      .house-ad-inline-slot {
        margin: 1.25rem 0;
      }

      .house-ad-rail {
        display: none;
      }

      h2[id] {
        scroll-margin-top: 1rem;
      }

      @media (min-width: 1500px) {
        .site-shell-house-ads {
          grid-template-columns: 280px minmax(0, 1fr) 280px;
          max-width: 1720px;
        }

        .site-shell-house-ads .main-content {
          max-width: 1040px;
        }

        .house-ad-inline-slot {
          display: none;
        }

        .house-ad-rail {
          display: block;
          min-width: 0;
          padding: 2rem 1rem 2rem 0;
        }

        .house-ad-rail-sticky {
          position: sticky;
          top: 94px;
          display: grid;
          gap: 1rem;
        }

        .house-ad-rail-secondary {
          margin-top: 0.15rem;
        }
      }

      @media (max-width: 700px) {
        .house-ad-inline-slot {
          margin: 1rem 0;
        }
      }
    </style>
  </body>
</html>
