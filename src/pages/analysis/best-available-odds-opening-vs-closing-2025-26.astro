const rows = [
  ["Liverpool v Bournemouth",100.54,102.01,1.47],["Aston Villa v Newcastle",100.94,101.65,0.71],["Brighton v Fulham",102.95,102.87,-0.08],["Sunderland v West Ham",102.82,101.76,-1.06],["Tottenham v Burnley",101.95,103.07,1.12],["Wolves v Man City",100.90,101.15,0.25],["Chelsea v Crystal Palace",102.15,101.39,-0.76],["Nott'm Forest v Brentford",102.19,102.71,0.52],["Man United v Arsenal",101.61,102.08,0.47],["Leeds v Everton",101.36,102.27,0.91]
