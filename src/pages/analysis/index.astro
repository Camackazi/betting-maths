---
import MainLayout from "../../layouts/MainLayout.astro";

const analyses = [
  {
    href: "/analysis/how-margin-compounds-in-accumulators/",
    tag: "Accumulator maths",
    title: "How Bookmaker Margin Compounds in Accumulators",
    description: "A reproducible model showing how a small pricing disadvantage on each leg can become much larger across a multi-leg accumulator."
  },
  {
    href: "/analysis/cash-out-fair-value/",
    tag: "Cash out",
    title: "What Is a Cash-Out Offer Worth? A Fair-Value Model",
    description: "A worked model for comparing a cash-out offer with the expected value of the bet at the current estimated probability."
  },
  {
    href: "/analysis/extra-places-mathematical-value/",
    tag: "Each-way offers",
    title: "What Does an Extra Place Actually Change?",
    description: "A transparent model showing how an additional place changes the expected return of the place half of an each-way bet."
  }
];
---

<MainLayout
  title="Betting Maths Analysis"
  description="Original Betting Maths analysis using transparent models and worked calculations to investigate bookmaker margin, accumulators, cash out, extra places and other betting questions."
>
  <section class="content-card">
    <p class="eyebrow">Original analysis</p>
    <h1>Betting Maths Analysis</h1>
    <p class="lead">This is where Betting Maths goes beyond definitions. We use transparent calculations, modelled examples and future data studies to investigate what betting prices and offer structures actually do mathematically.</p>
    <div class="callout"><strong>Reproducible by design:</strong> Each analysis explains its assumptions and shows enough of the calculation for readers to check the result. Modelled examples are labelled as models rather than presented as observed bookmaker data.</div>
  </section>

  <section class="content-card article-section">
    <h2>Current analyses</h2>
    <div class="analysis-grid">
      {analyses.map((analysis) => (
        <a class="analysis-card" href={analysis.href}>
          <span>{analysis.tag}</span>
          <h3>{analysis.title}</h3>
          <p>{analysis.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="content-card article-section">
    <h2>How this differs from a guide</h2>
    <p>A guide explains a concept such as overround, lay liability or expected value. An analysis starts with a question and works through the mathematics needed to answer it.</p>
    <p>For example, the accumulator guide can explain how to multiply prices. The analysis asks a different question: <strong>what happens to the effective pricing disadvantage when several margined prices are multiplied together?</strong></p>
  </section>

  <section class="content-card article-section">
    <h2>What we plan to measure</h2>
    <p>Future Betting Maths research can add observed market datasets alongside these modelled studies. Suitable projects include comparing bookmaker overrounds across competitions and market types, measuring cash-out discounts against a stated benchmark, comparing exchange commission effects and quantifying the mathematical impact of promotions.</p>
    <p>When real market data is used, the study will state the collection period, sample, calculation method and limitations.</p>
    <div class="button-row">
      <a class="button primary" href="/methodology/">Read the Methodology</a>
      <a class="button secondary" href="/editorial-standards/">Editorial Standards</a>
    </div>
  </section>

  <div class="callout"><strong>Responsible note:</strong> Analysis can explain price and risk. It cannot make an uncertain event certain, and Betting Maths does not provide betting tips or guaranteed profit strategies.</div>

  <style>
    .article-section { margin-top: 1.25rem; }
    .analysis-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
    .analysis-card { display: block; padding: 1.1rem; border: 1px solid var(--color-border); border-radius: 14px; background: var(--color-bg); }
    .analysis-card:hover { border-color: rgba(31, 138, 91, 0.45); transform: translateY(-2px); }
    .analysis-card span { display: inline-flex; margin-bottom: 0.55rem; padding: 0.15rem 0.55rem; border-radius: 999px; background: #eef8f3; color: var(--color-green-dark); font-size: 0.78rem; font-weight: 800; }
    .analysis-card p { margin: 0; }
    @media (max-width: 900px) { .analysis-grid { grid-template-columns: 1fr; } }
  </style>
</MainLayout>
