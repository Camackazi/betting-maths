---
import MainLayout from "../../layouts/MainLayout.astro";

const featuredGuides = [
  {
    href: "/guides/what-is-implied-probability/",
    tag: "Core guide",
    title: "What Is Implied Probability?",
    description: "Learn how betting odds convert into percentage chance and why implied probability matters."
  },
  {
    href: "/guides/bookmaker-margin-explained/",
    tag: "Core guide",
    title: "Bookmaker Margin Explained",
    description: "Understand bookmaker margin, overround, book percentage and how market prices are built."
  },
  {
    href: "/guides/what-is-lay-liability/",
    tag: "Core guide",
    title: "What Is Lay Liability?",
    description: "Learn the exchange betting risk behind lay bets, hedging and free bet conversion."
  }
];

const guideGroups = [
  {
    title: "Odds, probability and margin",
    guides: [
      { href: "/guides/what-is-implied-probability/", tag: "Odds", title: "What Is Implied Probability?", description: "Convert odds into percentage chance and understand what a price is suggesting." },
      { href: "/guides/no-vig-fair-odds/", tag: "Fair odds", title: "What Are No-Vig Fair Odds?", description: "Learn how bookmaker margin can be removed from a simple two-outcome market." },
      { href: "/guides/expected-value-betting/", tag: "Expected value", title: "What Is Expected Value in Betting?", description: "Learn how EV is calculated and why it depends on estimated probability." },
      { href: "/guides/bookmaker-margin-explained/", tag: "Bookmaker margin", title: "Bookmaker Margin Explained", description: "Learn how bookmaker margin, overround and book percentage are connected." },
      { href: "/guides/what-is-overround/", tag: "Overround", title: "What Is Overround in Betting?", description: "Understand how betting markets can add up to more than 100%." },
      { href: "/guides/how-bookmakers-make-money/", tag: "Bookmakers", title: "How Bookmakers Make Money", description: "Learn about overround, odds movement, liability management and weight of money." },
      { href: "/guides/can-you-always-beat-the-bookie/", tag: "Risk", title: "Can You Always Beat the Bookie?", description: "Learn why guaranteed betting systems are risky and what maths can actually show." }
    ]
  },
  {
    title: "Value, staking and stake splitting",
    guides: [
      { href: "/guides/what-is-the-kelly-criterion/", tag: "Staking", title: "What Is the Kelly Criterion?", description: "Learn how Kelly staking uses odds, bankroll and estimated probability." },
      { href: "/guides/what-is-dutching/", tag: "Dutching", title: "What Is Dutching in Betting?", description: "Learn how dutching splits stakes across multiple selections." },
      { href: "/guides/dutching-vs-arbitrage/", tag: "Arbitrage", title: "Dutching vs Arbitrage", description: "Understand the difference between stake splitting and covering all outcomes." }
    ]
  },
  {
    title: "Exchange, hedging and offers",
    guides: [
      { href: "/guides/what-is-lay-liability/", tag: "Exchange betting", title: "What Is Lay Liability?", description: "Understand how lay liability is calculated and why it matters on exchanges." },
      { href: "/guides/what-is-exchange-commission/", tag: "Exchange betting", title: "What Is Exchange Commission?", description: "Learn how commission affects lay bets, hedging, free bets and matched betting." },
      { href: "/guides/how-to-hedge-a-bet/", tag: "Hedging", title: "How to Hedge a Bet", description: "Understand back and lay hedging, lay liability, commission and greening up." },
      { href: "/guides/hedging-vs-cash-out/", tag: "Cash out", title: "Hedging vs Cash Out", description: "Compare bookmaker cash out offers with manual hedge calculations." },
      { href: "/guides/what-is-a-free-bet/", tag: "Free bets", title: "What Is a Free Bet?", description: "Understand free bet value, stake not returned, free bet lay stakes and offer terms." },
      { href: "/guides/what-is-matched-betting/", tag: "Matched betting", title: "What Is Matched Betting?", description: "Learn how qualifying bets, free bets, back bets and lay bets work together." },
      { href: "/guides/stake-returned-vs-stake-not-returned/", tag: "Free bet terms", title: "Stake Returned vs Stake Not Returned", description: "Learn the difference between cash-style returns and stake-not-returned free bets." }
    ]
  },
  {
    title: "Racing and each-way terms",
    guides: [
      { href: "/guides/each-way-betting-terms-explained/", tag: "Each-way", title: "Each-Way Betting Terms Explained", description: "Learn win part, place part, place terms, extra places, non-runners and Rule 4." },
      { href: "/guides/dead-heat-rules-betting/", tag: "Dead heat", title: "What Is a Dead Heat in Betting?", description: "Learn how dead heat rules can split stakes and adjust returns." },
      { href: "/guides/what-are-extra-places-in-each-way-betting/", tag: "Extra places", title: "What Are Extra Places in Each-Way Betting?", description: "Understand enhanced place offers and how they compare with standard each-way terms." },
      { href: "/guides/what-is-rule-4-in-horse-racing/", tag: "Horse racing", title: "What Is Rule 4 in Horse Racing?", description: "Learn why deductions happen after non-runners and how Rule 4 affects winnings." }
    ]
  }
];
---

<MainLayout
  title="Betting Maths Guides"
  description="Plain-English betting maths guides explaining implied probability, overround, bookmaker margin, expected value, no-vig fair odds, free bets, matched betting, each-way betting, dead heats, Rule 4, lay liability, exchange commission, Kelly staking, hedging, dutching, cash out and arbitrage."
>
  <section class="content-card">
    <p class="eyebrow">Betting guides</p>
    <h1>Betting Maths Guides</h1>
    <p class="lead">
      Learn the key betting maths concepts behind odds, implied probability, overround, bookmaker margin, expected value, no-vig fair odds, free bets, matched betting, lay liability, exchange commission, Kelly staking, each-way betting, dead heats, Rule 4, extra places, hedging, dutching, arbitrage and cash out.
    </p>

    <div class="callout">
      <strong>Quick guide:</strong> Start with implied probability if you are new to betting maths, then move on to bookmaker margin, expected value, no-vig fair odds, lay liability, each-way terms, Kelly staking, dutching and hedging.
    </div>
  </section>

  <section class="content-card article-section">
    <h2>Start here</h2>
    <p>These core guides explain the most important concepts behind the calculators on Betting Maths.</p>

    <div class="guide-grid">
      {featuredGuides.map((guide) => (
        <a class="guide-card featured-guide" href={guide.href}>
          <span>{guide.tag}</span>
          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
        </a>
      ))}
    </div>
  </section>

  {guideGroups.map((group) => (
    <section class="content-card article-section">
      <h2>{group.title}</h2>
      <div class="guide-grid">
        {group.guides.map((guide) => (
          <a class="guide-card" href={guide.href}>
            <span>{guide.tag}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="content-card article-section">
    <h2>Related calculator hub</h2>
    <p>If you want to use the tools directly, visit the full calculator hub.</p>
    <div class="button-row">
      <a class="button primary" href="/calculators/">Open All Betting Calculators</a>
      <a class="button secondary" href="/glossary/betting-jargon-explained/">Open Betting Glossary</a>
    </div>
  </section>

  <div class="callout">
    <strong>Responsible note:</strong> These guides are for education only. They do not provide betting tips, predictions or guaranteed profit strategies. Betting always involves risk.
  </div>

  <style>
    .article-section { margin-top: 1.25rem; }
    .guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
    .guide-card { display: block; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 14px; background: var(--color-bg); }
    .guide-card:hover { border-color: rgba(31, 138, 91, 0.45); transform: translateY(-2px); }
    .guide-card span { display: inline-flex; margin-bottom: 0.5rem; padding: 0.15rem 0.55rem; border-radius: 999px; background: #eef8f3; color: var(--color-green-dark); font-size: 0.78rem; font-weight: 800; }
    .guide-card.featured-guide { background: #eef8f3; border-color: rgba(31, 138, 91, 0.28); }
    .guide-card.featured-guide span { background: white; }
    .guide-card h3 { margin-bottom: 0.35rem; }
    .guide-card p { margin: 0; color: var(--color-muted); }
    @media (max-width: 1100px) { .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 760px) { .guide-grid { grid-template-columns: 1fr; } }
  </style>
</MainLayout>
