{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "betting-maths\\.vercel\\.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.bettingmaths.co.uk/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "bettingmaths\\.co\\.uk"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.bettingmaths.co.uk/$1"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
